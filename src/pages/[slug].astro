---
import Layout from '../layouts/Layout.astro';
import { keywords, cities, containerTypes } from '../seoData';
import FaqItem from '../components/FaqItem';
import {
  ChevronRight,
  ArrowRight,
  Phone,
  CheckCircle,
  Shield,
  Truck,
} from 'lucide-react';

export function getStaticPaths() {
  return keywords.map((kw) => ({
    params: { slug: kw.slug },
    props: { kw },
  }));
}

const { kw } = Astro.props;
const paragraphs = kw.content.split('\n\n').filter(Boolean);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": kw.h1,
  "description": kw.description,
  "image": `https://www.starcontainers.si${kw.image}`,
  "author": { "@type": "Organization", "name": "STAR Containers" },
  "publisher": { "@type": "Organization", "name": "STAR Containers", "url": "https://www.starcontainers.si" },
  "isPartOf": { "@type": "WebSite", "name": "STAR Containers", "url": "https://www.starcontainers.si" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": kw.faq.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Domov", "item": "https://www.starcontainers.si" },
    { "@type": "ListItem", "position": 2, "name": kw.h1.split(' – ')[0], "item": `https://www.starcontainers.si/${kw.slug}` }
  ]
};

const combinedSchema = JSON.stringify([articleSchema, faqSchema, breadcrumbSchema]);
---

<Layout
  title={kw.title}
  description={kw.description}
  keywords={kw.keywords.join(', ')}
  canonical={`https://www.starcontainers.si/${kw.slug}`}
  image={`https://www.starcontainers.si${kw.image}`}
  schema={combinedSchema}
>
  {/* Hero */}
  <section class="relative py-20 lg:py-28 overflow-hidden bg-gradient-to-br from-navy-800 via-navy-700 to-navy-900 mt-10">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 right-0 w-96 h-96 bg-orange-500 rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 text-orange-400 text-sm font-medium mb-4">
        <a href="/" class="hover:text-orange-300 transition-colors">Domov</a>
        <ChevronRight class="w-3 h-3" />
        <span>{kw.h1.split(' – ')[0]}</span>
      </div>
      <h1 class="text-4xl lg:text-6xl font-black text-white mb-6 leading-tight max-w-3xl animate-fade-in-up">
        {kw.h1}
      </h1>
      <p class="text-lg text-gray-300 max-w-2xl leading-relaxed mb-8">
        {kw.description}
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/#kontakt" class="group flex items-center gap-2 bg-orange-500 hover:bg-orange-400 text-white font-bold px-7 py-4 rounded-full transition-all hover:shadow-xl hover:shadow-orange-500/25 hover:-translate-y-1">
          Brezplačno povpraševanje
          <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
        <a href="tel:+38630555001" class="flex items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold px-7 py-4 rounded-full transition-all hover:-translate-y-1">
          <Phone class="w-4 h-4" />
          +386 30 555 001
        </a>
      </div>
    </div>
  </section>

  {/* Content */}
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">
          {/* Feature image */}
          <div class="mb-8 rounded-2xl overflow-hidden aspect-[16/9] shadow-xl">
            <img
              src={kw.image}
              alt={kw.h1}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>

          {/* Intro text */}
          <div class="space-y-4 text-gray-600 dark:text-gray-400 leading-relaxed mb-10">
            {paragraphs.map((p) => (
              <p class="text-base">{p}</p>
            ))}
          </div>

          {/* Price table for cena/ladijski pages */}
          {(kw.slug === 'kontejner-cena' || kw.slug === 'ladijski-kontejner') && (
            <div class="mb-10 bg-navy-50 dark:bg-navy-800/30 rounded-2xl p-6 border border-navy-100 dark:border-navy-700/30">
              <h3 class="text-lg font-bold mb-4">Cenik kontejnerjev 2025</h3>
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-gray-200 dark:border-gray-700">
                      <th class="text-left py-2.5 px-3 font-bold">Tip kontejnerja</th>
                      <th class="text-left py-2.5 px-3 font-bold hidden sm:table-cell">Kapaciteta</th>
                      <th class="text-right py-2.5 px-3 font-bold">Cena od (brez DDV)</th>
                    </tr>
                  </thead>
                  <tbody>
                    {containerTypes.map((ct) => (
                      <tr key={ct.slug} class="border-b border-gray-100 dark:border-gray-800 hover:bg-orange-50 dark:hover:bg-orange-950/20 transition-colors">
                        <td class="py-2.5 px-3 font-semibold">{ct.name}</td>
                        <td class="py-2.5 px-3 text-gray-500 dark:text-gray-400 hidden sm:table-cell">{ct.capacity}</td>
                        <td class="py-2.5 px-3 font-black text-orange-500 text-right text-base">€{ct.price}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-3">* Cene so brez DDV (22%). Dostava se obračuna posebej glede na lokacijo.</p>
            </div>
          )}

          {/* Sections */}
          {kw.sections.map((section) => (
            <div class="mb-8">
              <h2 class="text-2xl font-black mb-4 text-gray-900 dark:text-white">
                {section.title}
              </h2>
              <p class="text-gray-600 dark:text-gray-400 leading-relaxed">{section.body}</p>
            </div>
          ))}

          {/* Quick features */}
          <div class="grid sm:grid-cols-2 gap-4 mt-8 mb-10">
            {[
              { icon: Truck, title: 'Dostava 48h', desc: 'Po vsej Sloveniji brez skrbi' },
              { icon: Shield, title: 'ISO certificirani', desc: 'Pregledani pred vsako dostavo' },
              { icon: CheckCircle, title: 'Direktno iz Hongkonga', desc: 'Brez posrednikov, nižje cene' },
              { icon: Phone, title: 'Podpora 7 dni', desc: 'Odgovorimo v 2 urah' },
            ].map((b) => (
              <div key={b.title} class="flex items-start gap-3 p-4 bg-navy-50 dark:bg-navy-800/30 rounded-xl border border-navy-100 dark:border-navy-700/30">
                <div class="w-9 h-9 bg-orange-500 rounded-lg flex items-center justify-center flex-shrink-0">
                  <b.icon class="w-4 h-4 text-white" />
                </div>
                <div>
                  <div class="font-bold text-sm">{b.title}</div>
                  <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">{b.desc}</div>
                </div>
              </div>
            ))}
          </div>

          {/* FAQ */}
          <div class="mt-10">
            <h2 class="text-2xl font-black mb-6">Pogosta vprašanja</h2>
            <div class="space-y-3">
              {kw.faq.map((f) => (
                <FaqItem client:load q={f.q} a={f.a} />
              ))}
            </div>
          </div>
        </div>

        {/* Sidebar */}
        <div class="space-y-6">
          {/* Contact card */}
          <div class="bg-navy-700 rounded-2xl p-6">
            <h3 class="font-bold mb-2 text-white">Brezplačno povpraševanje</h3>
            <p class="text-navy-200 text-sm mb-4">Odgovorimo v 2 urah. Brez obveznosti.</p>
            <div class="space-y-3 text-sm mb-4">
              <a href="tel:+38630555001" class="flex items-center gap-2.5 text-white/80 hover:text-orange-400 transition-colors">
                <Phone class="w-4 h-4 text-orange-400" />
                +386 30 555 001
              </a>
            </div>
            <a href="/#kontakt" class="block w-full bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 rounded-xl text-center text-sm transition-colors">
              Pošlji povpraševanje
            </a>
          </div>

          {/* City links */}
          <div class="bg-gray-50 dark:bg-navy-800/30 rounded-2xl p-6 border border-gray-100 dark:border-navy-700/30">
            <h3 class="font-bold mb-4">Kontejnerji po mestih</h3>
            <div class="space-y-1.5">
              {cities.slice(0, 10).map((c) => (
                <a
                  key={c.slug}
                  href={`/kontejner/${c.slug}`}
                  class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-orange-500 transition-colors py-1"
                >
                  <ChevronRight class="w-3 h-3 text-orange-500 flex-shrink-0" />
                  Kontejner {c.name}
                </a>
              ))}
            </div>
          </div>

          {/* Other keyword links */}
          <div class="bg-gray-50 dark:bg-navy-800/30 rounded-2xl p-6 border border-gray-100 dark:border-navy-700/30">
            <h3 class="font-bold mb-4">Sorodni vodniki</h3>
            <div class="space-y-1.5">
              {keywords.filter((k) => k.slug !== kw.slug).map((k) => (
                <a
                  key={k.slug}
                  href={`/${k.slug}`}
                  class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-orange-500 transition-colors py-1"
                >
                  <ChevronRight class="w-3 h-3 text-orange-500 flex-shrink-0" />
                  {k.h1.split(' – ')[0]}
                </a>
              ))}
            </div>
          </div>

          {/* Container types */}
          <div class="bg-gray-50 dark:bg-navy-800/30 rounded-2xl p-6 border border-gray-100 dark:border-navy-700/30">
            <h3 class="font-bold mb-4">Naši kontejnerji</h3>
            <div class="space-y-2">
              {containerTypes.slice(0, 6).map((ct) => (
                <div key={ct.slug} class="flex items-center justify-between text-sm py-1.5 border-b border-gray-100 dark:border-gray-700 last:border-0">
                  <span class="text-gray-700 dark:text-gray-300 font-medium">{ct.name}</span>
                  <span class="text-orange-500 font-bold">€{ct.price}</span>
                </div>
              ))}
            </div>
            <a href="/#kontejnerji" class="mt-4 block text-sm text-orange-500 hover:text-orange-600 font-semibold transition-colors">
              Vsi kontejnerji →
            </a>
          </div>

          {/* Facebook backlink */}
          <a
            href="https://www.facebook.com/profile.php?id=61590607888405"
            target="_blank"
            rel="noopener"
            class="flex items-center gap-3 bg-[#1877F2] hover:bg-[#166fe5] text-white font-bold px-5 py-4 rounded-2xl transition-all hover:shadow-lg hover:shadow-blue-500/25 group"
          >
            <svg class="w-6 h-6 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            <div>
              <div class="text-xs text-blue-200 font-medium">Facebook</div>
              <div class="text-sm">Aktualna zaloga</div>
            </div>
            <svg class="w-4 h-4 ml-auto group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </a>

          {/* Skladiscko backlink */}
          <div class="bg-navy-700 rounded-2xl p-6">
            <div class="text-xs font-semibold text-orange-400 uppercase tracking-widest mb-2">Partnerski portal</div>
            <h3 class="font-bold text-white mb-2">Iščete skladiščne rešitve?</h3>
            <p class="text-navy-200 text-sm mb-4 leading-relaxed">
              Obiščite <strong class="text-white">skladiscko.si</strong> – portal za skladiščne prostore, kontejnerje in logistične rešitve v Sloveniji.
            </p>
            <a
              href="https://skladiscko.si/"
              target="_blank"
              rel="noopener"
              class="flex items-center justify-between bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 px-4 rounded-xl text-sm transition-colors group"
            >
              Obiščite skladiscko.si
              <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="py-16 bg-orange-500 relative overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute -top-24 -right-24 w-64 h-64 bg-orange-400 rounded-full opacity-30"></div>
      <div class="absolute -bottom-16 -left-16 w-48 h-48 bg-orange-600 rounded-full opacity-30"></div>
    </div>
    <div class="relative max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-black text-white mb-3">{kw.h1.split(' – ')[0]} – Kontaktirajte nas</h2>
      <p class="text-orange-100 mb-6">Brezplačno povpraševanje brez obveznosti. Odgovorimo v 2 urah.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/#kontakt" class="flex items-center gap-2 bg-white text-orange-600 font-bold px-7 py-3.5 rounded-full hover:bg-orange-50 transition-all hover:-translate-y-0.5">
          Pošlji povpraševanje
          <ArrowRight class="w-4 h-4" />
        </a>
        <a href="tel:+38630555001" class="flex items-center gap-2 bg-black/20 border border-white/20 text-white font-bold px-7 py-3.5 rounded-full hover:bg-black/30 transition-all hover:-translate-y-0.5">
          <Phone class="w-4 h-4" />
          +386 30 555 001
        </a>
      </div>
    </div>
  </section>
</Layout>
