---
import Layout from '../layouts/Layout.astro';
import { containerTypes, cities, keywords } from '../seoData';
import FaqItem from '../components/FaqItem';
import {
  ChevronRight,
  ArrowRight,
  Phone,
  CheckCircle,
  Shield,
  Truck,
  Package,
  Lock,
  Droplets,
  Ruler,
  Star,
  Warehouse,
} from 'lucide-react';

const faq = [
  {
    q: 'Kaj je skladiščni kontejner?',
    a: 'Skladiščni kontejner je ladijski ISO kontejner, ki se uporablja za varno, suho in zaščiteno shranjevanje blaga, opreme, materialov in predmetov. Jeklena konstrukcija ga ščiti pred vremenskimi vplivi, vlomom in požarom.',
  },
  {
    q: 'Koliko stane skladiščni kontejner?',
    a: 'Skladiščni kontejner 10ft stane od 1.790 €, 20ft od 1.990 € in 40ft od 2.700 € (vse brez DDV). Rabljeni kontejnerji so za 30–40 % cenejši. Dostava se obračuna posebej.',
  },
  {
    q: 'Koliko prostora ponuja skladiščni kontejner?',
    a: '10ft kontejner ponuja 14 m³, 20ft 33 m³, 40ft 67 m³ in 40ft High Cube 76 m³ notranjega prostora. 20ft kontejner sprejme do 11 EUR palet.',
  },
  {
    q: 'Ali skladiščni kontejner potrebuje temelje?',
    a: 'Za začasno postavitev temelji niso potrebni. Kontejner postavimo na ravno, čvrsto podlago (beton, gramoz, asfalt). Za trajno postavitev priporočamo betonsko ploščo ali jekleno podkonstrukcijo.',
  },
  {
    q: 'Ali je kontejner vodotesen in zaščiten pred vlomom?',
    a: 'Da. Vsi naši kontejnerji so vodotesni (preverimo pred dostavo) in imajo ojačene protivlomne zaklepe. Na zahtevo montiramo dodatne varnostne sisteme ali ključavnice.',
  },
  {
    q: 'Kako hitro dobim dostavo skladiščnega kontejnerja?',
    a: 'Standardna dostava je v 48 urah od potrditve naročila. Kontejnerje dostavimo po vsej Sloveniji s kamionom s klikalko brez potrebe po žerjavu ali posebni opremi.',
  },
];

const useCases = [
  {
    icon: Package,
    title: 'Kmetijstvo in vinarstvo',
    desc: 'Shranjevanje kmetijske mehanizacije, gnojil, pridelkov in sezonske opreme. Idealno za kmetije, vinograde in sadovnjake.',
    img: '/photos/20ft-4.webp',
  },
  {
    icon: Warehouse,
    title: 'Gradbeništvo',
    desc: 'Varno shranjevanje orodja, gradbenih materialov in strojev neposredno na gradbišču. Premestljiv v 30 minutah.',
    img: '/photos/20ft-a1.webp',
  },
  {
    icon: Package,
    title: 'E-commerce in logistika',
    desc: 'Skladiščenje zaloge, embalaže in paketov za spletne trgovine. Stroškovno učinkovita alternativa najemu skladiščnih prostorov.',
    img: '/photos/40ft-hc-0.webp',
  },
  {
    icon: Star,
    title: 'Osebna raba',
    desc: 'Shranjevanje pohištva, avtomobilov, motorjev, sezonske opreme in osebnih predmetov. Odlična alternativa dragi zunanji shrambi.',
    img: '/photos/20ft-7.webp',
  },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Skladiščni kontejner – Varno in suho shranjevanje | STAR Containers",
  "description": "Skladiščni kontejnerji za varno shranjevanje blaga, opreme in materialov. Vodoodporni, protivlomni, certificirani. Dostava po vsej Sloveniji v 48h. Od 1.790 €.",
  "image": "https://www.starcontainers.si/photos/20ft-4.webp",
  "author": { "@type": "Organization", "name": "STAR Containers" },
  "publisher": { "@type": "Organization", "name": "STAR Containers", "url": "https://www.starcontainers.si" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const schema = JSON.stringify([articleSchema, faqSchema]);
---

<Layout
  title="Skladiščni kontejner – Varno in suho shranjevanje | STAR Containers"
  description="Skladiščni kontejnerji za varno shranjevanje blaga, opreme in materialov. Vodoodporni, protivlomni, certificirani ISO. Dostava po vsej Sloveniji v 48h. Od 1.790 € (brez DDV)."
  keywords="skladiščni kontejner, kontejner za skladiščenje, skladiščenje v kontejnerju, kontejner shramba, kontejner za shranjevanje, ladijski kontejner skladišče"
  canonical="https://www.starcontainers.si/skladiscni-kontejner"
  image="https://www.starcontainers.si/photos/20ft-4.webp"
  schema={schema}
>

  {/* ── HERO ─────────────────────────────────────────────── */}
  <section class="relative min-h-[88vh] flex items-center overflow-hidden bg-gradient-to-br from-navy-950 via-navy-800 to-navy-900 mt-10">
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute -top-32 -right-32 w-[600px] h-[600px] bg-orange-500/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-orange-600/10 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <div class="flex items-center gap-2 text-orange-400 text-sm font-medium mb-6">
          <a href="/" class="hover:text-orange-300 transition-colors">Domov</a>
          <ChevronRight class="w-3 h-3" />
          <span>Skladiščni kontejner</span>
        </div>

        <h1 class="text-5xl lg:text-7xl font-black text-white mb-6 leading-tight">
          Skladiščni<br />
          <span class="text-orange-400">kontejner</span>
        </h1>

        <p class="text-lg text-gray-300 leading-relaxed mb-8 max-w-lg">
          Varno, suho in protivlomno shranjevanje z ladijskim ISO kontejnerjem. Dostava po vsej Sloveniji v <strong class="text-white">48 urah</strong>. Cene od <strong class="text-orange-400">1.790 €</strong> brez DDV.
        </p>

        <div class="flex flex-wrap gap-3 mb-10">
          {[
            { label: 'Vodotesen', icon: Droplets },
            { label: 'ISO certificiran', icon: CheckCircle },
            { label: 'Dostava 48h', icon: Truck },
            { label: 'Protivlomen', icon: Lock },
          ].map((b) => (
            <div key={b.label} class="flex items-center gap-1.5 bg-white/8 border border-white/10 rounded-full px-3.5 py-1.5 text-sm text-gray-200">
              <b.icon class="w-3.5 h-3.5 text-orange-400" />
              {b.label}
            </div>
          ))}
        </div>

        <div class="flex flex-wrap gap-4">
          <a href="/#kontakt" class="group flex items-center gap-2 bg-orange-500 hover:bg-orange-400 text-white font-bold px-8 py-4 rounded-full transition-all hover:shadow-2xl hover:shadow-orange-500/30 hover:-translate-y-1">
            Brezplačno povpraševanje
            <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </a>
          <a href="tel:+38630555001" class="flex items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold px-8 py-4 rounded-full transition-all hover:-translate-y-1">
            <Phone class="w-4 h-4" />
            +386 30 555 001
          </a>
        </div>
      </div>

      <div class="relative">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl shadow-black/40 aspect-[4/3]">
          <img
            src="/photos/20ft-4.webp"
            alt="Skladiščni kontejner 20ft"
            class="w-full h-full object-cover"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-navy-950/60 via-transparent to-transparent"></div>
          <div class="absolute top-4 right-4 bg-orange-500 text-white font-black text-sm px-4 py-2 rounded-full shadow-lg">
            Od 1.790 €
          </div>
          <div class="absolute bottom-4 left-4 right-4 flex justify-around bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl py-4 px-2">
            {[
              { val: '500+', sub: 'v zalogi' },
              { val: '48h', sub: 'dostava' },
              { val: 'ISO', sub: 'certificirani' },
              { val: '10+', sub: 'let izkušenj' },
            ].map((s) => (
              <div key={s.val} class="text-center">
                <div class="text-xl font-black text-orange-400">{s.val}</div>
                <div class="text-xs text-gray-300">{s.sub}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── WHY CONTAINER ────────────────────────────────────── */}
  <section class="py-20 bg-white dark:bg-navy-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <div class="inline-block text-xs font-bold uppercase tracking-widest text-orange-500 bg-orange-50 dark:bg-orange-950/30 border border-orange-100 dark:border-orange-900/30 rounded-full px-4 py-1.5 mb-4">
          Zakaj kontejner?
        </div>
        <h2 class="text-4xl lg:text-5xl font-black mb-4">Idealna rešitev za skladiščenje</h2>
        <p class="text-gray-500 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed">
          Ladijski kontejner je robusten, vodotesen in varnostno trden – zasnovan za ekstremne razmere na morju, kar ga naredi popolnega za dolgoročno skladiščenje na kopnem.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          {
            icon: Droplets,
            title: 'Vodotesen',
            desc: 'Jeklena konstrukcija in tesna tesnila na vratih preprečujejo prodiranje vlage, dežja in snega v notranjost.',
            colorClass: 'bg-blue-50 dark:bg-blue-950/30 border-blue-100 dark:border-blue-900/30',
            iconBg: 'bg-blue-100 dark:bg-blue-900/40',
            iconColor: 'text-blue-600 dark:text-blue-400',
          },
          {
            icon: Lock,
            title: 'Protivlomen',
            desc: 'Ojačena jeklena vrata z varnostnimi zaklepi. Možnost montaže dodatnih ključavnic in varnostnih sistemov.',
            colorClass: 'bg-green-50 dark:bg-green-950/30 border-green-100 dark:border-green-900/30',
            iconBg: 'bg-green-100 dark:bg-green-900/40',
            iconColor: 'text-green-600 dark:text-green-400',
          },
          {
            icon: Ruler,
            title: 'Velik izbor velikosti',
            desc: 'Od 10ft (14 m³) za zasebno rabo do 40ft HC (76 m³) za obsežna podjetja. Vedno na zalogi.',
            colorClass: 'bg-orange-50 dark:bg-orange-950/30 border-orange-100 dark:border-orange-900/30',
            iconBg: 'bg-orange-100 dark:bg-orange-900/40',
            iconColor: 'text-orange-600 dark:text-orange-400',
          },
          {
            icon: Truck,
            title: 'Takoj dostopno',
            desc: 'Kontejnerji so na zalogi v Ptuju. Dostava po vsej Sloveniji v 48 urah brez zapletov.',
            colorClass: 'bg-purple-50 dark:bg-purple-950/30 border-purple-100 dark:border-purple-900/30',
            iconBg: 'bg-purple-100 dark:bg-purple-900/40',
            iconColor: 'text-purple-600 dark:text-purple-400',
          },
        ].map((card) => (
          <div key={card.title} class={`rounded-2xl border p-6 scroll-animate opacity-0 ${card.colorClass}`}>
            <div class={`w-12 h-12 rounded-xl flex items-center justify-center mb-4 ${card.iconBg}`}>
              <card.icon class={`w-6 h-6 ${card.iconColor}`} />
            </div>
            <h3 class="font-bold text-lg mb-2">{card.title}</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── SIZE & PRICE TABLE ────────────────────────────────── */}
  <section class="py-20 bg-gray-50 dark:bg-navy-900/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="inline-block text-xs font-bold uppercase tracking-widest text-orange-500 bg-orange-50 dark:bg-orange-950/30 border border-orange-100 dark:border-orange-900/30 rounded-full px-4 py-1.5 mb-4">
            Cenik 2025
          </div>
          <h2 class="text-4xl font-black mb-4">Cene skladiščnih kontejnerjev</h2>
          <p class="text-gray-500 dark:text-gray-400 leading-relaxed mb-8">
            Vse cene so brez DDV (22 %). Dostava se obračuna posebej glede na lokacijo. Kontaktirajte nas za individualno ponudbo z dostavo.
          </p>

          <div class="space-y-3">
            {containerTypes.map((ct) => (
              <div key={ct.slug} class="flex items-center justify-between bg-white dark:bg-navy-800/60 border border-gray-100 dark:border-navy-700/40 rounded-xl px-5 py-4 hover:border-orange-300 dark:hover:border-orange-700 transition-colors group">
                <div>
                  <div class="font-bold group-hover:text-orange-500 transition-colors">{ct.name}</div>
                  <div class="text-xs text-gray-400 mt-0.5">{ct.dims} · {ct.capacity}</div>
                </div>
                <div class="text-right">
                  <div class="text-xl font-black text-orange-500">€{ct.price}</div>
                  <div class="text-xs text-gray-400">brez DDV</div>
                </div>
              </div>
            ))}
          </div>

          <p class="text-xs text-gray-400 mt-4">* Rabljeni kontejnerji so za 30–40 % cenejši. Preverite razpoložljivost.</p>
        </div>

        <div class="space-y-5">
          <img
            src="/photos/40ft-hc-1.webp"
            alt="Velikosti skladiščnih kontejnerjev"
            class="rounded-2xl shadow-xl w-full object-cover aspect-[4/3]"
            loading="lazy"
          />
          <img
            src="/photos/20ft-2.webp"
            alt="20ft skladiščni kontejner"
            class="rounded-2xl shadow-xl w-full object-cover aspect-[16/7]"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  {/* ── USE CASES ─────────────────────────────────────────── */}
  <section class="py-20 bg-white dark:bg-navy-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <div class="inline-block text-xs font-bold uppercase tracking-widest text-orange-500 bg-orange-50 dark:bg-orange-950/30 border border-orange-100 dark:border-orange-900/30 rounded-full px-4 py-1.5 mb-4">
          Primeri uporabe
        </div>
        <h2 class="text-4xl lg:text-5xl font-black mb-4">Za koga je skladiščni kontejner?</h2>
        <p class="text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
          Skladiščni kontejner je vsestranska rešitev za posameznike, podjetnike, kmetovalce in gradbince.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        {useCases.map((uc) => (
          <div key={uc.title} class="group relative rounded-3xl overflow-hidden aspect-[16/9] shadow-lg hover:shadow-2xl transition-shadow">
            <img
              src={uc.img}
              alt={uc.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/85 via-navy-900/30 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h3 class="text-xl font-black text-white mb-1">{uc.title}</h3>
              <p class="text-sm text-gray-300 leading-relaxed">{uc.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── WHAT CAN YOU STORE ────────────────────────────────── */}
  <section class="py-20 bg-gray-50 dark:bg-navy-900/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <img
            src="/photos/20ft-a2.webp"
            alt="Notranjost skladiščnega kontejnerja"
            class="rounded-3xl shadow-2xl w-full object-cover aspect-[4/3]"
            loading="lazy"
          />
        </div>
        <div class="order-1 lg:order-2">
          <div class="inline-block text-xs font-bold uppercase tracking-widest text-orange-500 bg-orange-50 dark:bg-orange-950/30 border border-orange-100 dark:border-orange-900/30 rounded-full px-4 py-1.5 mb-4">
            Kaj shraniti?
          </div>
          <h2 class="text-4xl font-black mb-6">V kontejnerju shranite praktično vse</h2>
          <div class="grid sm:grid-cols-2 gap-3">
            {[
              'Gradbeno orodje in stroji',
              'Kmetijska mehanizacija',
              'Pohištvo in oprema za dom',
              'Sezonski predmeti',
              'Arhivska gradiva',
              'Blago za e-commerce',
              'Avtomobili in motorji',
              'Industrijske komponente',
              'Športna oprema',
              'Rezervni deli',
              'Embalaža in zaloge',
              'Električna oprema',
            ].map((item) => (
              <div key={item} class="flex items-center gap-2.5 text-sm text-gray-700 dark:text-gray-300">
                <CheckCircle class="w-4 h-4 text-orange-500 flex-shrink-0" />
                {item}
              </div>
            ))}
          </div>
          <div class="mt-8 p-5 bg-orange-50 dark:bg-orange-950/20 border border-orange-100 dark:border-orange-900/30 rounded-2xl">
            <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
              <strong class="text-gray-900 dark:text-white">Standardni 20ft kontejner</strong> prenese do <strong>28.250 kg koristnega tovora</strong> in ima prostornino <strong>33 m³</strong> – zadostuje za vso opremo povprečnega podjetja ali kmetije.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── COMPARISON ────────────────────────────────────────── */}
  <section class="py-20 bg-white dark:bg-navy-950">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="inline-block text-xs font-bold uppercase tracking-widest text-orange-500 bg-orange-50 dark:bg-orange-950/30 border border-orange-100 dark:border-orange-900/30 rounded-full px-4 py-1.5 mb-4">
          Primerjava
        </div>
        <h2 class="text-4xl font-black mb-4">Kontejner vs. alternativne rešitve</h2>
        <p class="text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
          Zakaj je ladijski kontejner boljša izbira od klasičnih skladiščnih alternativ?
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-gray-100 dark:border-navy-700/40 shadow-lg">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-navy-800 text-white">
              <th class="text-left py-4 px-5 font-bold">Kriterij</th>
              <th class="text-center py-4 px-4 font-bold text-orange-400">Skladiščni kontejner</th>
              <th class="text-center py-4 px-4 font-bold text-gray-300">Najem garaže</th>
              <th class="text-center py-4 px-4 font-bold text-gray-300">Lesena uta</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['Cena (enkratna)', '1.790–4.990 €', '300–600 €/leto', '800–2.500 €'],
              ['Vodotesnost', '✅ Popolna', '⚠️ Odvisno', '❌ Slaba'],
              ['Protivlomnost', '✅ Jeklo + zaklepi', '⚠️ Odvisno', '❌ Šibka'],
              ['Mobilnost', '✅ Premestljiv', '❌ Ni', '⚠️ Omejeno'],
              ['Dovoljenje', '✅ Ni potrebno*', '✅ Ni potrebno', '⚠️ Pogosto'],
              ['Vzdržljivost', '✅ 25+ let', '—', '⚠️ 10–15 let'],
              ['Dostava', '✅ 48 ur', '❌ Iskati treba', '⚠️ Vgradnja'],
            ].map(([row, a, b, c], i) => (
              <tr key={row} class={i % 2 === 0 ? 'bg-white dark:bg-navy-800/30' : 'bg-gray-50 dark:bg-navy-800/60'}>
                <td class="py-3.5 px-5 font-semibold text-gray-700 dark:text-gray-200">{row}</td>
                <td class="py-3.5 px-4 text-center text-orange-600 dark:text-orange-400 font-semibold">{a}</td>
                <td class="py-3.5 px-4 text-center text-gray-500 dark:text-gray-400">{b}</td>
                <td class="py-3.5 px-4 text-center text-gray-500 dark:text-gray-400">{c}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-400 text-center mt-3">* Za začasno postavitev do 12 mesecev. Preverite lokalne predpise.</p>
    </div>
  </section>

  {/* ── FAQ ───────────────────────────────────────────────── */}
  <section class="py-20 bg-gray-50 dark:bg-navy-900/50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="inline-block text-xs font-bold uppercase tracking-widest text-orange-500 bg-orange-50 dark:bg-orange-950/30 border border-orange-100 dark:border-orange-900/30 rounded-full px-4 py-1.5 mb-4">
          FAQ
        </div>
        <h2 class="text-4xl font-black">Pogosta vprašanja</h2>
      </div>
      <div class="space-y-3">
        {faq.map((f) => (
          <FaqItem client:load q={f.q} a={f.a} />
        ))}
      </div>
    </div>
  </section>

  {/* ── CONTENT + SIDEBAR ─────────────────────────────────── */}
  <section class="py-20 bg-white dark:bg-navy-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-10">
        <div class="lg:col-span-2 space-y-10">
